<Subscription xmlns="http://schemas.microsoft.com/2006/03/windows/events/subscription">
  <SubscriptionId>OT-Lab-Workgroup-HTTPS</SubscriptionId>
  <SubscriptionType>SourceInitiated</SubscriptionType>
  <Description>Selected benign OT lab heartbeat and audited sign-in events; issued-certificate HTTPS only.</Description>
  <Enabled>true</Enabled>
  <Uri>http://schemas.microsoft.com/wbem/wsman/1/windows/EventLog</Uri>
  <ConfigurationMode>Custom</ConfigurationMode>
  <Delivery Mode="Push">
    <Batching><MaxItems>1</MaxItems><MaxLatencyTime>30000</MaxLatencyTime></Batching>
    <PushSettings><Heartbeat Interval="60000" /></PushSettings>
  </Delivery>
  <Query><![CDATA[
    <QueryList>
      <Query Id="0" Path="Application">
        <Select Path="Application">*[System[Provider[@Name='OT-Lab'] and EventID=1000]]</Select>
      </Query>
      <Query Id="1" Path="Security">
        <Select Path="Security">*[System[(EventID=4624 or EventID=4625)]]</Select>
      </Query>
    </QueryList>
  ]]></Query>
  <ReadExistingEvents>false</ReadExistingEvents>
  <TransportName>HTTPS</TransportName>
  <ContentFormat>RenderedText</ContentFormat>
  <Locale Language="en-US" />
  <LogFile>ForwardedEvents</LogFile>
  <AllowedSourceNonDomainComputers>
    <IssuerCAList><IssuerCA>{{ISSUER_CA_THUMBPRINT}}</IssuerCA></IssuerCAList>
    <AllowedSubjectList><Subject>{{ALLOWED_SOURCE_FQDN}}</Subject></AllowedSubjectList>
    <DeniedSubjectList />
  </AllowedSourceNonDomainComputers>
  <AllowedSourceDomainComputers>O:NSG:NSD:</AllowedSourceDomainComputers>
</Subscription>
